{
  "name": "edmunds-design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm generate && pnpm --recursive --sort --if-present build",
    "dev": "pnpm --filter @edmunds/eds-docs dev",
    "generate": "tsx scripts/generate.ts",
    "lint:eds": "tsx scripts/lint-eds.ts",
    "test": "pnpm generate && vitest run",
    "typecheck": "tsc --noEmit",
    "eds": "tsx packages/cli/src/index.ts",
    "mcp": "tsx apps/mcp-service/src/index.ts",
    "check": "pnpm lint:eds && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/express": "^5.0.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^27.1.0",
    "playwright": "^1.56.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vite": "8.1.3",
    "vitest": "^4.1.10"
  }
}
