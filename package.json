{
  "name": "edmunds-design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm generate && pnpm --recursive --sort --if-present build",
    "dev": "pnpm --filter @edmunds/eds-docs dev",
    "generate": "tsx scripts/generate.ts",
    "venom:import": "tsx scripts/import-venom.ts",
    "venom:check": "tsx scripts/import-venom.ts --check",
    "figma:verify": "tsx scripts/validate-figma.ts",
    "typography:verify": "pnpm generate && tsx scripts/validate-typography.ts",
    "check:generated": "pnpm generate && git diff --exit-code -- generated apps/docs/public packages/tokens/generated packages/figma/generated",
    "lint:eds": "tsx scripts/lint-eds.ts",
    "test": "pnpm generate && vitest run",
    "typecheck": "tsc --noEmit",
    "eds": "tsx packages/cli/src/index.ts",
    "mcp": "tsx apps/mcp-service/src/index.ts",
    "check": "pnpm lint:eds && pnpm typecheck && pnpm typography:verify && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/express": "^5.0.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "^27.1.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vite": "8.1.3",
    "vitest": "^4.1.10"
  }
}
