{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "blue": {
      "700": {"$type": "color", "$value": "#003B70"},
      "600": {"$type": "color", "$value": "#00599C"},
      "500": {"$type": "color", "$value": "#0077B8"},
      "100": {"$type": "color", "$value": "#DDEFFD"}
    },
    "ink": {
      "900": {"$type": "color", "$value": "#17232D"},
      "700": {"$type": "color", "$value": "#354754"},
      "500": {"$type": "color", "$value": "#61727D"}
    },
    "gray": {
      "100": {"$type": "color", "$value": "#F3F6F8"},
      "200": {"$type": "color", "$value": "#E2E8EC"},
      "400": {"$type": "color", "$value": "#A8B5BD"}
    },
    "white": {"$type": "color", "$value": "#FFFFFF"},
    "green": {"$type": "color", "$value": "#16825D"},
    "amber": {"$type": "color", "$value": "#B15B00"},
    "red": {"$type": "color", "$value": "#B42318"}
  },
  "space": {
    "0": {"$type": "dimension", "$value": "0px"},
    "1": {"$type": "dimension", "$value": "4px"},
    "2": {"$type": "dimension", "$value": "8px"},
    "3": {"$type": "dimension", "$value": "12px"},
    "4": {"$type": "dimension", "$value": "16px"},
    "5": {"$type": "dimension", "$value": "24px"},
    "6": {"$type": "dimension", "$value": "32px"},
    "7": {"$type": "dimension", "$value": "48px"},
    "8": {"$type": "dimension", "$value": "64px"}
  },
  "radius": {
    "control": {"$type": "dimension", "$value": "6px"},
    "surface": {"$type": "dimension", "$value": "10px"},
    "pill": {"$type": "dimension", "$value": "999px"}
  },
  "font": {
    "family": {
      "body": {"$type": "fontFamily", "$value": ["Arial", "Helvetica", "sans-serif"]},
      "display": {"$type": "fontFamily", "$value": ["Arial Narrow", "Arial", "sans-serif"]},
      "data": {"$type": "fontFamily", "$value": ["IBM Plex Mono", "SFMono-Regular", "monospace"]}
    },
    "size": {
      "caption": {"$type": "dimension", "$value": "12px"},
      "body": {"$type": "dimension", "$value": "16px"},
      "title": {"$type": "dimension", "$value": "24px"},
      "display": {"$type": "dimension", "$value": "48px"}
    }
  },
  "duration": {
    "fast": {"$type": "duration", "$value": "120ms"},
    "normal": {"$type": "duration", "$value": "220ms"}
  },
  "breakpoint": {
    "sm": {"$type": "dimension", "$value": "576px"},
    "md": {"$type": "dimension", "$value": "768px"},
    "lg": {"$type": "dimension", "$value": "992px"},
    "xl": {"$type": "dimension", "$value": "1200px"}
  },
  "semantic": {
    "surface": {
      "page": {"$type": "color", "$value": "{color.gray.100}"},
      "raised": {"$type": "color", "$value": "{color.white}"},
      "brand": {"$type": "color", "$value": "{color.blue.700}"}
    },
    "text": {
      "primary": {"$type": "color", "$value": "{color.ink.900}"},
      "secondary": {"$type": "color", "$value": "{color.ink.700}"},
      "inverse": {"$type": "color", "$value": "{color.white}"}
    },
    "action": {
      "primary": {"$type": "color", "$value": "{color.blue.600}"},
      "primaryHover": {"$type": "color", "$value": "{color.blue.700}"},
      "focus": {"$type": "color", "$value": "{color.blue.500}"}
    },
    "border": {
      "default": {"$type": "color", "$value": "{color.gray.200}"},
      "strong": {"$type": "color", "$value": "{color.gray.400}"}
    },
    "status": {
      "success": {"$type": "color", "$value": "{color.green}"},
      "warning": {"$type": "color", "$value": "{color.amber}"},
      "danger": {"$type": "color", "$value": "{color.red}"}
    },
    "price": {
      "good": {"$type": "color", "$value": "{color.green}"}
    }
  }
}
